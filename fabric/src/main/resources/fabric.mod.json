{
  "schemaVersion": 1,
  "id": "ldlib2",
  "version": "${version}",
  "name": "LDLib2",
  "description": "LDLib2 — UI, rendering, synchronization, persistence, and in-game editors library",
  "authors": [
    "TheyCallMeAbstract"
  ],
  "contact": {
    "homepage": "https://github.com/We-Are-Stardust/ldlib2",
    "sources": "https://github.com/We-Are-Stardust/ldlib2"
  },
  "license": "MIT",
  "icon": "assets/ldlib2/textures/gui/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lowdragmc.lowdraglib2.fabric.LDLib2Fabric"
    ],
    "client": [
      "com.lowdragmc.lowdraglib2.fabric.client.LDLib2FabricClient"
    ],
    "fabric-gametest": [
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricSmokeGameTest",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricUIGameTests",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricRegistryGameTests",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricResourceGameTests",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricSyncDataGameTests",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricNodeGraphGameTests",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricNodeGraphPreviewGameTests",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricContainerMenuGameTest",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricFluidHelperGameTest",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricFluidSlotGameTest",
      "com.lowdragmc.lowdraglib2.fabric.gametest.FabricItemTransferListGameTest"
    ]
  },
  "mixins": [
    "ldlib2.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "architectury": ">=20.0.12",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=3.9.1"
  },
  "recommends": {
    "jei": "*"
  }
}
